require_once 'config.inc';
require_once 'util.inc';
require_once 'system.inc';
require_once 'interfaces.inc';
require_once 'filter.inc';

exit_on_bootup();

/*
 * With "selected <if1,if2,...>" only the named logical interfaces are
 * reconfigured.  Any other argument keeps the historical gateway alarm mode.
 */
$selected = ($argv[1] ?? '') === 'selected';
$interface_map = [];
if ($selected) {
    foreach (array_filter(explode(',', (string)($argv[2] ?? ''))) as $interface) {
        $interface = trim($interface);
        if ($interface !== '' && isset($config['interfaces'][$interface])) {
            $interface_map[$interface] = true;
        }
    }
    $interface_map = array_keys($interface_map);
    if (empty($interface_map)) {
        log_msg('ROUTING: refusing selected configure without valid interfaces', LOG_ERR);
        exit(1);
    }
}
$monitor_hook = !$selected && !empty($argv[1]);
$monitor_gws = $argv[2] ?? '';

/* drop deleted routes */
foreach (glob("/tmp/delete_route_*.todo") as $filename) {
    $network = trim(file_get_contents($filename));
    $inet = is_subnetv6($network) ? 'inet6' : 'inet';
    mwexecfm('/sbin/route delete -%s %s', [$inet, $network]);
    unlink($filename);
}

/* routing is not allowed to restart monitors when extended hook is requested */
system_routing_configure(true, $selected ? $interface_map : null, !$monitor_hook);

if ($monitor_hook) {
    pass_safe('/usr/local/etc/rc.syshook monitor %s', $monitor_gws);
}

filter_configure_sync(true, false);
